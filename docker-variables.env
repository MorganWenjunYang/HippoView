### ByoCypher settings ##

# Public image registry settings.
# Defaults avoid Docker Hub auth.docker.io token fetches during local test runs.
PYTHON_BUILDER_IMAGE=public.ecr.aws/docker/library/python:3.12
PYTHON_RUNTIME_IMAGE=public.ecr.aws/docker/library/python:3.12-slim
MONGODB_IMAGE=public.ecr.aws/docker/library/mongo:7.0
NEO4J_IMAGE=public.ecr.aws/docker/library/neo4j:5.15-community
ELASTICSEARCH_IMAGE=public.ecr.aws/docker/library/elasticsearch:8.11.0

# Toggle for running database setup on container startup; setting be yes/no
FILL_DB_ON_STARTUP=yes

# Name of database created by BioCypher; Relevant for path to import script => import/$BC_TABLE_NAME/neo4j-admin-import-call.sh
BC_TABLE_NAME=clinical_trials


### NEO4j settings ##

# Username for Neo4j database
NEO4J_USER=neo4j

# Password for Neo4j database
NEO4J_PASSWORD=neo4jpassword

# Username and password divided by "/" for Neo4j; Has to match $NEO4J_USER/$NEO4J_PASSWORD
NEO4J_AUTH=neo4j/neo4jpassword


### DO NOT CHANGE ###

# Variable necessary to use enterprise version of dockerized Neo4j
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes


# MongoDB Settings:
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=clinical_trials
MONGO_USER=admin
MONGO_PASSWORD=adminpassword

# Elasticsearch Settings:
ELASTICSEARCH_PORT=9200

# Application Ports:
MCP_SERVER_PORT=8000
STREAMLIT_PORT=8501

# Optional LLM/API keys for containerized test runs.
# Fill only the provider you select in the Streamlit sidebar.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
TAVILY_API_KEY=

# Optional AACT credentials, only needed when loading trial data from AACT.
AACT_USER=
AACT_PWD=

# Neo4j Additional Settings:
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# NEO4J_HEAP_SIZE=1G
# NEO4J_PAGECACHE_SIZE=512M
# Let Neo4j auto-detect optimal memory settings

# Data Processing Settings:
# Default data source when not specified
DEFAULT_DATA_SOURCE=mongo
# Default dataset when not specified
DEFAULT_DATASET=clinical_trials
